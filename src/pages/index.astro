---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import FeatureCard from '../components/FeatureCard.astro';
import MissionSection from '../components/MissionSection.astro';
import CompanySection from '../components/CompanySection.astro';
import ManufacturingSection from '../components/ManufacturingSection.astro';
import LineupSection from '../components/LineupSection.astro';
import ScrollAnimations from '../components/ScrollAnimations.astro';
import ishigakiImage from '../images/ishigaki01.webp';
import ishigakiImage2 from '../images/ishigaki02.webp';
import ishigakiImage3 from '../images/ishigaki03.webp'; 
import waveImage1 from '../images/wave1.webp';
import kyuufuImage from '../images/kyuufu2.png';
import Salad from '../images/salad.webp';
import Bread from '../images/bread.webp';
import Vin from '../images/vin.webp';
import Icon from '../images/icon.webp';

const products = [
  {
    name: 'WET生ハム',
    description: '柔らかく、深い旨味',
    category: 'Premium'
  },
  {
    name: 'ビオレッタ',
    description: 'DRY熟成の芳醇',
    category: 'Signature'
  },
  {
    name: '山羊ベーコン',
    description: '豊かな香りと食感',
    category: 'Classic'
  },
  {
    name: '山羊刺身',
    description: '鮮烈な美味しさ',
    category: 'Fresh'
  }
];
---

<Layout title="石垣野底山羊ハム | 四分休符の島からの贈り物">
  <!-- 一時的にページローディング時のアニメーションを停止中 -->

    <main id="main-content" class="relative">
    <!-- Hero -->
    <Hero
      videoSources={[
        '/bg1.mp4',
      ]}
    />
    <!-- Feature Sections -->
    <div class="max-w-7xl mx-auto px-6 md:px-12 text-black bg-[#fffaf2] pt-8 md:pt-12">
      <FeatureCard
        tag="Premium & Rare"
        title="山羊の新たな可能性の発信"  
        description="沖縄の方言でヒージャーと呼ばれる山羊は、琉球王朝時代（約15世紀頃）から食されてきた歴史と文化があります。\nそして、古来より沖縄では山羊はヌチグスイ（命の薬）と言われ重宝され（滋養強壮、産後女性の栄養補給等あらゆる万能薬として）、又祝い事(晴れの日)には欠かせない、島人にとっては心ともいえる大事な食材です。今、琉球石垣島から山羊の新たな可能性を創造・発信し、山羊食文化のリーディングモデルを目指します。"
        imagePath={ishigakiImage.src}
        textColor="text-black"
        subTextColor="text-black"
      />

      <FeatureCard
        tag="Lifestyle"
        title="島酒と山羊ハムで、小休止。"
        description="いつも頑張っている皆々様へ。泡盛(島酒)と山羊ハム。日常に「四分休符」を打つ、贅沢なひとときを。"
        imagePath={ishigakiImage2.src}
        reverse={true}
      />
    </div>

    <!-- Lineup Section -->
    <LineupSection products={products} />

    <!-- Mission Section -->
    <MissionSection imagePath={ishigakiImage3.src} />

    <!-- Philosophy Section -->
    <section class="pt-0 pb-32 md:pb-48 px-6 relative overflow-hidden">
      <!-- wave1.webp を背景に設定 -->
      <div class="absolute inset-0 -z-10">
        <img
          src={waveImage1.src}
          alt="背景の波のイメージ"
          class="w-full h-full object-cover"
          loading="lazy"
        />
      </div>

      <div class="max-w-4xl mx-auto text-center relative z-10 items-center">

        <h2 class="text-sm font-sans tracking-[0.4em] uppercase text-sky-600 mb-8 mt-12">Philosophy</h2>
        <p class="text-3xl md:text-5xl font-light leading-relaxed mb-12 tracking-wide text-white">
          メロディも人生も<br/>
          休みは必要ですよ
        </p>

        <div class="flex md:flex-row flex-col md:gap-20 gap-4 items-center justify-center">
        <img src={Icon2.src} alt="Icon" class="w-30 h-auto" />
        <div class="max-w-2xl mx-auto space-y-8 text-white leading-loose text-sm md:text-base font-light">
          <p class="tracking-wider">
            音楽における「四分休符」は、静寂という名の旋律。<br class="hidden md:block"/>
            その小さな間が、次の音をより美しく響かせる。
          </p>
          <p class="tracking-wider">
            石垣島野底の山羊ハムは、忙しい日常に打つ、贅沢な休符。<br class="hidden md:block"/>
            ほんの一瞬の小休止が、明日への活力を生む。
          </p>
        </div>
        <img src={Icon.src} alt="Icon" class="w-30 h-auto" />
        </div>
      </div>
    </section>

    <!-- Pairing Section -->
    <section class="py-32 md:py-48 px-6 relative overflow-hidden">
      <div class="absolute inset-0 bg-linear-to-b from-transparent via-sky-200/40 to-transparent -z-10"></div>

      <div class="max-w-5xl mx-auto">
        <div class="text-center">
          <h2 class="text-sm font-sans tracking-[0.4em] uppercase text-sky-600 mb-4">Pairing</h2>
          <p class="text-2xl md:text-4xl font-light tracking-wide text-slate-800">島酒とともに</p>
        </div>

        <div class="relative p-8 rounded-[2.5rem] overflow-hidden">
          <div class="text-center space-y-8">
            <p class="text-lg md:text-2xl font-light leading-loose tracking-wide text-slate-800">
              石垣島の泡盛（島酒）と山羊ハム。<br class="hidden md:block"/>
              この島が育んだ二つの味わいが、<br class="hidden md:block"/>
              至福のマリアージュを奏でる。
            </p>
            <div class="pt-6">
              <p class="text-xs md:text-sm text-slate-600 font-light tracking-widest">
                ゆったりと流れる島時間の中で、心を解きほぐす
              </p>
            </div>
          </div>

          <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8">
            <div class="group relative rounded-3xl overflow-hidden border border-sky-200/40 bg-white/60 backdrop-blur-sm shadow-[0_18px_45px_rgba(15,23,42,0.08)]">
              <img
                src={Vin.src}
                alt="お酒のおともに"
                class="h-56 w-full object-cover transition-transform duration-1200 group-hover:scale-[1.03]"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-linear-to-t from-slate-900/45 via-transparent to-transparent"></div>
              <p class="absolute bottom-5 left-6 right-6 text-white text-sm md:text-base font-light tracking-wider">
                お酒のおともに。
              </p>
            </div>

            <div class="group relative rounded-3xl overflow-hidden border border-sky-200/40 bg-white/60 backdrop-blur-sm shadow-[0_18px_45px_rgba(15,23,42,0.08)]">
              <img
                src={Bread.src}
                alt="パンにはさんで"
                class="h-56 w-full object-cover transition-transform duration-1200 group-hover:scale-[1.03]"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-linear-to-t from-slate-900/45 via-transparent to-transparent"></div>
              <p class="absolute bottom-5 left-6 right-6 text-white text-sm md:text-base font-light tracking-wider">
                パンにはさんで。
              </p>
            </div>

            <div class="group relative rounded-3xl overflow-hidden border border-sky-200/40 bg-white/60 backdrop-blur-sm shadow-[0_18px_45px_rgba(15,23,42,0.08)]">
              <img
                src={Salad.src}
                alt="サラダに添えて"
                class="h-56 w-full object-cover transition-transform duration-1200 group-hover:scale-[1.03]"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-linear-to-t from-slate-900/45 via-transparent to-transparent"></div>
              <p class="absolute bottom-5 left-6 right-6 text-white text-sm md:text-base font-light tracking-wider">
                サラダに添えて。
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 販売会社 -->
    <CompanySection />

    <!-- 製造受託会社 -->
    <ManufacturingSection />

    <!-- お問い合わせ導線 -->
    <section class="py-20 md:py-28 px-6">
      <div class="max-w-5xl mx-auto">
        <div class="relative rounded-4xl overflow-hidden bg-white/70 backdrop-blur-sm border border-sky-200/30 shadow-[0_30px_100px_rgba(15,23,42,0.08)]">
          <div class="absolute inset-0 bg-linear-to-b from-white/60 via-transparent to-transparent -z-10"></div>
          <div class="p-8 md:p-12 text-center">
            <h2 class="text-sm font-sans tracking-[0.4em] uppercase text-sky-600 mb-10">お問い合わせ</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
              <div class="rounded-3xl border border-sky-200/50 bg-white/80 p-6 md:p-8 text-center transition hover:bg-white hover:border-sky-300/70 space-y-5">
                <h3 class="text-lg md:text-xl font-light leading-relaxed tracking-wide text-slate-800">
                  商品の品質に関するお問い合わせ
                </h3>
                <p class="text-sm md:text-base text-slate-600 font-light leading-relaxed">
                  品質や保存方法、製造に関するご質問はこちらからお問い合わせください。<br class="hidden md:block"/>宛先：株式会社Ever Food
                </p>
                <a
                  href="https://everfood.co.jp/contact"
                  class="inline-flex items-center justify-center rounded-full bg-sky-700 px-7 py-3 text-xs md:text-sm font-sans tracking-[0.2em] uppercase text-white ring-1 ring-sky-200/40 transition hover:bg-sky-600 focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-300"
                >
                  お問い合わせ
                </a>
              </div>

              <div class="rounded-3xl border border-sky-200/50 bg-white/80 p-6 md:p-8 text-center transition hover:bg-white hover:border-sky-300/70 space-y-5">
                <h3 class="text-lg md:text-xl font-light leading-relaxed tracking-wide text-slate-800">
                  その他のお問い合わせ
                </h3>
                <p class="text-sm md:text-base text-slate-600 font-light leading-relaxed">
                  取引・共同開発・メディア掲載など、その他のご相談はこちらからご連絡ください。<br class="hidden md:block"/>宛先：合同会社龍宮野底
                </p>
                <a
                  href="/contact?type=other"
                  class="inline-flex items-center justify-center rounded-full bg-slate-700 px-7 py-3 text-xs md:text-sm font-sans tracking-[0.2em] uppercase text-white ring-1 ring-slate-200/40 transition hover:bg-slate-600 focus:outline-none focus-visible:ring-2 focus-visible:ring-slate-300"
                >
                  お問い合わせ
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer id="contact" class="py-24 md:py-32 px-6 border-t border-sky-200/20 relative scroll-mt-24">
      <div class="max-w-7xl mx-auto">
        <div class="flex flex-col items-center gap-12 text-slate-600">
          <!-- ロゴエリア -->
          <div class="flex flex-col items-center gap-6">
            <div class="w-20 h-20 border border-sky-300/30 rotate-45 flex items-center justify-center transition-transform duration-700 hover:rotate-90">
              <div class="w-3 h-3 bg-sky-400/60 rounded-full"></div>
            </div>
            <div class="text-center space-y-2">
              <p class="text-sm tracking-[0.3em] text-slate-700">石垣島山羊ハム</p>
              <p class="text-[10px] tracking-[0.4em] uppercase font-sans text-slate-600">Made with Ishigaki Island</br>ヒージャー</p>
            </div>
          </div>

          <!-- リンク -->
          <div class="flex flex-wrap justify-center gap-8 text-[10px] tracking-[0.3em] uppercase font-sans">
            <span class="hover:text-sky-500 transition-colors cursor-pointer">RYUKYU NOSOKO</span>
            <span class="text-slate-400">·</span>
            <span class="hover:text-sky-500 transition-colors cursor-pointer"><a href="https://everfood.co.jp/">Everfood</a></span>
            <span class="text-slate-400">·</span>
            <a
              href="/contact"
              class="hover:text-sky-500 transition-colors cursor-pointer"
            >
              お問い合わせ
            </a>
          </div>

          <!-- コピーライト -->
          <div class="text-center space-y-3">
            <div class="h-px w-32 mx-auto bg-linear-to-r from-transparent via-sky-300/30 to-transparent"></div>
            <p class="text-[10px] tracking-wider">
              © {new Date().getFullYear()} RYUKYU NOSOKO Limited Liability Company. All Rights Reserved.
            </p>
          </div>
        </div>
      </div>
    </footer>
  </main>

  <!-- スクロールアニメーション -->
  <ScrollAnimations />

  <!-- Hero下のCanvas波アニメーション -->
  <script is:inline>
    window.addEventListener('load', () => {
      const canvas = document.getElementById('hero-wave-canvas');
      if (!(canvas instanceof HTMLCanvasElement)) return;

      const ctx = canvas.getContext('2d');
      if (!ctx) return;

      let degree = 0;
      const amplitude = 20;
      const period = 500;
      const waveSpeed = 8;

      const resizeCanvas = () => {
        const rect = canvas.getBoundingClientRect();
        canvas.width = rect.width;
        canvas.height = rect.height;
      };

      resizeCanvas();
      window.addEventListener('resize', resizeCanvas);

      const loop = () => {
        ctx.clearRect(0, 0, canvas.width, canvas.height);

        // 1. 全体を淡い色で塗る（元・画像部分）
        ctx.globalCompositeOperation = 'source-over';
        ctx.fillStyle = '#fffaf2'; // お好みで変更可（淡い色）
        ctx.fillRect(0, 0, canvas.width, canvas.height);

        // 2. 波形で下部をくり抜き、下のセクションの色を見せる
        ctx.globalCompositeOperation = 'destination-out';

        const waveStartY = canvas.height - 100;

        ctx.beginPath();
        ctx.moveTo(0, waveStartY);

        for (let x = 0; x <= canvas.width; x++) {
          const y = amplitude * Math.sin((Math.PI / period) * (degree + x));
          ctx.lineTo(x, waveStartY + y);
        }

        ctx.lineTo(canvas.width, canvas.height);
        ctx.lineTo(0, canvas.height);
        ctx.closePath();

        ctx.fill();

        degree += waveSpeed;
        requestAnimationFrame(loop);
      };

      loop();
    });
  </script>

  <style>
    /* 各文字のスタイル */
    .char-0, .char-1, .char-2, .char-3, .char-4, .char-5, .char-6, .char-7, .char-8 {
      font-family: "Noto Serif JP", serif;
      font-size: clamp(1.8rem, 5vw, 3.5rem);
      font-weight: 300;
      letter-spacing: 0.3em;
      fill: transparent;
      stroke: #44403c;
      stroke-width: 1px;
      stroke-dasharray: 200;
      stroke-dashoffset: 200;
    }

    /* 各文字に遅延を設けて順番に描画 */
    .char-0 {
      animation: drawChar 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0s forwards;
    }
    .char-1 {
      animation: drawChar 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.2s forwards;
    }
    .char-2 {
      animation: drawChar 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.4s forwards;
    }
    .char-3 {
      animation: drawChar 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.6s forwards;
    }
    .char-4 {
      animation: drawChar 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.8s forwards;
    }
    .char-5 {
      animation: drawChar 0.8s cubic-bezier(0.22, 1, 0.36, 1) 1.0s forwards;
    }
    .char-6 {
      animation: drawChar 0.8s cubic-bezier(0.22, 1, 0.36, 1) 1.2s forwards;
    }
    .char-7 {
      animation: drawChar 0.8s cubic-bezier(0.22, 1, 0.36, 1) 1.4s forwards;
    }
    .char-8 {
      animation: drawChar 0.8s cubic-bezier(0.22, 1, 0.36, 1) 1.6s forwards;
    }

    @keyframes drawChar {
      0% {
        stroke-dashoffset: 200;
        fill: transparent;
      }
      60% {
        stroke-dashoffset: 0;
        fill: transparent;
      }
      100% {
        stroke-dashoffset: 0;
        fill: #44403c;
      }
    }

    /* アニメーション完了後にメインコンテンツを表示 */
    #main-content {
      transition: opacity 1s ease-in-out;
    }

    #main-content.show {
      opacity: 1;
    }

    /* アニメーション完了後にテキストアニメーションを非表示 */
    #text-animation {
      transition: opacity 1s ease-in-out;
    }

    #text-animation.hide {
      opacity: 0;
      pointer-events: none;
    }
  </style>

  <script>
    // 全文字のアニメーション完了を待つ（最後の文字のアニメーション開始 + アニメーション時間 + フェードアウト時間）
    const totalAnimationTime = 1600 + 800 + 1000; // 最後の文字の開始時間(1.6s) + アニメーション時間(0.8s) + フェードアウト時間(1s)

    setTimeout(() => {
      const textAnimation = document.getElementById('text-animation');
      const mainContent = document.getElementById('main-content');
      
      if (textAnimation && mainContent) {
        textAnimation.classList.add('hide');
        mainContent.classList.add('show');
        
        // フェードアウト完了後にDOMから削除
        setTimeout(() => {
          textAnimation.remove();
        }, 1000);
      }
    }, totalAnimationTime);
  </script>
</Layout>
