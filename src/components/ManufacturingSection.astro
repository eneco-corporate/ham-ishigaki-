<section id="manufacturing" class="py-16 md:py-12 px-6 relative overflow-hidden scroll-mt-24 bg-[#fffaf2]">
  <div class="absolute inset-0 bg-linear-to-b from-transparent via-sky-100/20 to-transparent -z-10"></div>

  <div class="max-w-4xl mx-auto text-center">
    <h2 class="text-sm font-sans tracking-[0.4em] uppercase text-sky-600 mb-6">
      山羊生ハム共同開発会社
    </h2>

    <div class="space-y-4 text-slate-700">
      <p class="text-base md:text-lg font-medium tracking-wide">
        <a
          href="https://everfood.co.jp/"
          target="_blank"
          rel="noopener noreferrer"
          class="text-slate-800 underline decoration-sky-300/70 underline-offset-4 transition hover:text-sky-700 hover:decoration-sky-500 text-xl md:text-3xl"
        >
          株式会社 Ever Food
        </a>
      </p>

      <p class="text-sm md:text-base text-slate-600 tracking-wider leading-relaxed">
        これからも合同会社龍宮野底と共に山羊の新たな価値を創造していきます
      </p>
    </div>
