---
import Image from 'astro/components/Image.astro';
import islandImage from '../images/island.png';
import Icon from '../images/icon.webp';
import Icon2 from '../images/icon2.webp';

interface Props {
  /** Hero背景に流す動画のパス配列（例: ['/hero1.mp4', ...]） */
  videoSources?: string[];
}

const { videoSources = [] } = Astro.props;
---


  <!-- 背景動画（4本を順番に再生） -->
  {videoSources.length > 0 && (
    <div class="pointer-events-none absolute inset-0 z-0 overflow-hidden">
      <video
        id="hero-bg-video"
        class="w-full md:h-[120vh] h-[110vh] object-cover opacity-80"
        autoplay
        muted
        loop
        preload="auto"
        playsinline
        src={videoSources[0]}
        data-sources={JSON.stringify(videoSources)}
      ></video>
    </div>
  )}
<section class="min-h-screen flex flex-col items-center justify-center text-center px-6 py-20 relative overflow-hidden">
  <!-- 画面中央の島（テキストの後ろ） -->
  <div class="pointer-events-none absolute inset-0 z-10 flex items-center justify-center">
    <Image
      src={islandImage}
      alt="石垣島"
      class="w-64 h-auto object-cover"
    />
  </div>

  <!-- メインコピー -->
  <div class="relative z-20 animate-fade-in-delayed flex flex-col items-center">
    <p class="text-xs md:text-sm font-sans tracking-[0.3em] uppercase text-white mb-6 font-light">
      RYUUKYUU NOSOKO 
    </p>

    <h1 class="mb-8 font-zen-kaku">
      <span class="block text-lg md:text-2xl font-light tracking-[0.25em] mb-6 text-white italic">
        Rest in Melody, Rest in Life.
      </span>
      <span class="block text-3xl md:text-3xl lg:t  ext-3xl tracking-tight leading-[0.95] relative text-black">
        石垣島へ息抜きに来ませんか？
      </span>
    </h1>

    <!-- サブコピー -->
    <div class="max-w-2xl mx-auto space-y-8 mt-16 font-zen-kaku">
      <p class="text-base md:text-xl tracking-[0.2em] leading-relaxed text-black relative">
        ちょっと小休止しましょ<br/>
        <span class="hidden md:inline">　</span>青い波と風にふれて<br/>
        ほんのちょっとだけ心を円くしませんか
      </p>

      <div class="pt-6 flex flex-col items-center gap-3 font-zen-kaku">
        <div class="w-px h-12 from-transparent via-sky-400/60 to-transparent flex flex-col items-center justify-center"></div>
        <div class="flex flex-row md:gap-20 gap-０ items-center justify-center"> 
        <img src={Icon2.src} alt="Icon" class="w-30 h-auto" />
          <p class="text-sky-600 text-xs md:text-sm tracking-[0.3em] font-sans font-bold text-center whitespace-nowrap shrink-0">
            四分休符の島　石垣
          </p>  
          <img src={Icon.src} alt="Icon" class="w-30 h-auto" />
        </div>
      </div>

      <!-- CTA -->
      <div class="pt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="#lineup"
          class="inline-flex items-center justify-center rounded-full bg-rose-800 px-8 py-3 text-xs md:text-sm font-sans tracking-[0.25em] uppercase text-white shadow-[0_30px_80px_rgba(159,18,57,0.25)] ring-1 ring-rose-200/40 transition hover:bg-rose-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-rose-300"
        >
          Lineup
        </a>
        <a
          href="#company"
          class="inline-flex items-center justify-center rounded-full bg-white/60 px-8 py-3 text-xs md:text-sm font-sans tracking-[0.25em] uppercase text-slate-800 ring-1 ring-slate-200/70 backdrop-blur-md transition hover:bg-white/80 focus:outline-none focus-visible:ring-2 focus-visible:ring-rose-200"
        >
          Contact
        </a>
      </div>
    </div>
  </div>

  <!-- スクロールインジケーター -->
  <div class="absolute bottom-12 left-1/2 -translate-x-1/2 animate-bounce-slow">
    <div class="flex flex-col items-center gap-2">
      <div class="w-px h-16 bg-linear-to-b from-slate-400/50 to-transparent"></div>
      <span class="text-[9px] font-sans tracking-[0.3em] uppercase text-slate-600">Scroll</span>
    </div>
  </div>
</section>

<style>
  /* ダイヤモンドバッジのスタイル */
  .diamond-container {
    perspective: 1000px;
  }

  .diamond-badge {
    position: relative;
    width: 120px;
    height: 120px;
    transform: rotate(45deg);
    transition: transform 0.8s ease;
  }

  .diamond-badge:hover {
    transform: rotate(45deg) scale(1.1);
  }

  .diamond-inner {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, rgba(56, 189, 248, 0.15) 0%, rgba(56, 189, 248, 0.08) 100%);
    border: 1px solid rgba(56, 189, 248, 0.4);
    backdrop-filter: blur(10px);
    box-shadow:
      0 0 40px rgba(0, 0, 0, 0.1),
      inset 0 0 20px rgba(56, 189, 248, 0.15);
    transform: rotate(-45deg);
  }

  /* アニメーション */
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes fadeInDelayed {
    0% { opacity: 0; transform: translateY(30px); }
    40% { opacity: 0; transform: translateY(30px); }
    100% { opacity: 1; transform: translateY(0); }
  }

  @keyframes float {
    0%, 100% { transform: translate(0, 0) rotate(45deg); }
    33% { transform: translate(10px, -20px) rotate(45deg); }
    66% { transform: translate(-15px, 10px) rotate(45deg); }
  }

  @keyframes floatDelayed {
    0%, 100% { transform: translate(0, 0) rotate(45deg); }
    33% { transform: translate(-15px, 20px) rotate(45deg); }
    66% { transform: translate(20px, -10px) rotate(45deg); }
  }

  @keyframes bounceSlow {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }

  .animate-fade-in {
    animation: fadeIn 1.5s ease-out forwards;
  }

  .animate-fade-in-delayed {
    animation: fadeInDelayed 2s ease-out forwards;
  }

  .animate-float {
    animation: float 18s ease-in-out infinite;
  }

  .animate-float-delayed {
    animation: floatDelayed 22s ease-in-out infinite;
  }

  .animate-bounce-slow {
    animation: bounceSlow 3s ease-in-out infinite;
  }
</style>

<script is:inline>
  const setupHeroVideoRotation = () => {
    const video = document.getElementById('hero-bg-video');
    if (!(video instanceof HTMLVideoElement)) return;

    const sourcesAttr = video.dataset.sources;
    if (!sourcesAttr) return;

    let sources;
    try {
      sources = JSON.parse(sourcesAttr);
    } catch {
      return;
    }

    if (!Array.isArray(sources) || sources.length === 0) return;

    let index = 0;

    const setSource = () => {
      const src = sources[index];
      video.src = src;

      // 動画ごとに再生速度を調整（例: bg2だけゆっくり）
      if (typeof src === 'string' && src.includes('bg2')) {
        video.playbackRate = 0.5; // お好みで調整（1.0 が通常）
      } else {
        video.playbackRate = 1.0;
      }

      video.currentTime = 0;
      video.play().catch(() => {});
    };

    // 1本目はすでに表示されているが、念のため同期
    setSource();

    // 固定時間ごとに次の動画へ切り替え（例: 15秒）
    const DURATION_MS = 15000;
    setInterval(() => {
      index = (index + 1) % sources.length;
      setSource();
    }, DURATION_MS);
  };

  if (document.readyState === 'loading') {
    window.addEventListener('DOMContentLoaded', setupHeroVideoRotation);
  } else {
    setupHeroVideoRotation();
  }
</script>
