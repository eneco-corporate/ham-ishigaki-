<section id="manufacturing" class="py-32 md:py-48 px-6 relative overflow-hidden scroll-mt-24 bg-[#fffaf2]">
  <div class="absolute inset-0 bg-linear-to-b from-transparent via-sky-100/20 to-transparent -z-10"></div>

  <div class="max-w-4xl mx-auto text-center">
    <h2 class="text-sm font-sans tracking-[0.4em] uppercase text-sky-600 mb-6">製造受託会社</h2>

    <p class="text-xs md:text-sm font-sans tracking-[0.2em] text-slate-500 mb-10">
      Manufacturing Partner
    </p>

    <div class="space-y-4 text-slate-700">
      <p class="text-base md:text-lg font-medium tracking-wide">
        <a
          href="https://everfood.co.jp/"
          target="_blank"
          rel="noopener noreferrer"
          class="text-slate-800 underline decoration-sky-300/70 underline-offset-4 transition hover:text-sky-700 hover:decoration-sky-500"
        >
          株式会社Everfood
        </a>
      </p>
      <p class="text-sm md:text-base text-slate-600 tracking-wider leading-relaxed">
        本商品の製造を受託しています。
      </p>
    </div>
  </div>
</section>
