---
import Image from 'astro/components/Image.astro';
import hamImage from '../images/ham.png';
import backImage from '../images/back.png';

interface Product {
  name: string;
  description: string;
  category: string;
}

interface Props {
  products: Product[];
}

const { products } = Astro.props;
---

<section id="lineup" class="py-24 md:py-40 px-6 relative overflow-hidden scroll-mt-24 bg-[#fffaf2]">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-16 md:mb-24">
      <h2 class="text-sm font-sans tracking-[0.4em] uppercase text-sky-600 mb-4">Lineup</h2>
      <p class="text-2xl md:text-4xl font-light tracking-wide text-slate-800">島のめぐみ</p>
    </div>

    <div class="flex flex-col sm:flex-row justify-center items-center gap-6 md:gap-8">
      <!-- ham.png（左） -->
      <div class="w-full max-w-[280px] sm:max-w-xs md:max-w-sm">
        <div class="relative rounded-[2rem] overflow-hidden shadow-xl">
          <Image
            src={hamImage}
            alt="石垣島山羊ハム ラインナップ"
            class="w-full h-auto object-cover"
          />
        </div>
      </div>
      <!-- back.png（右） -->
      <div class="w-full max-w-[280px] sm:max-w-xs md:max-w-sm">
        <div class="relative rounded-[2rem] overflow-hidden shadow-xl">
          <Image
            src={backImage}
            alt="石垣島山羊ハム"
            class="w-full h-auto object-cover"
          />
        </div>
      </div>
    </div>
  </div>
</section>
